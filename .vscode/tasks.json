{
	"tasks": [
		{
			"type": "shell",
			"label": "Configure Debug audio_effect_gui",
			"command": "cmake",
			"args": [
				"-S",
				"${workspaceFolder}",
				"-B",
				"${workspaceFolder}/build",
				"-DCMAKE_BUILD_TYPE=Debug"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"type": "shell",
			"label": "Build audio_effect_gui",
			"command": "cmake",
			"args": [
				"--build",
				"${workspaceFolder}/build",
				"--target",
				"audio_effect_gui"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": "Configure Debug audio_effect_gui",
			"dependsOrder": "sequence",
			"problemMatcher": [
				"$gcc"
			]
		},
		{
			"type": "cppbuild",
			"label": "C/C++: g++ build active file",
			"command": "/usr/bin/g++",
			"args": [
				"-fdiagnostics-color=always",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}"
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"detail": "Task generated by Debugger."
		},
		{
			"label": "Profile MIDI player",
			"type": "shell",
			"command": "cmake --build \"${workspaceFolder}/build\" --target audio_effect_gui && perf record -g --call-graph dwarf -o \"${workspaceFolder}/build/midi-player.perf.data\" -- \"${workspaceFolder}/build/audio_effect_gui\" \"${workspaceFolder}/assets/patches/midi.json\" && perf report -i \"${workspaceFolder}/build/midi-player.perf.data\"",
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	],
	"version": "2.0.0"
}